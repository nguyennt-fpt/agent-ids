# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ─── Agent runtime data (SQLite DB + datasets copied at runtime) ────────────────
agent/data/*.db
agent/data/*.jsonl
!agent/data/.gitkeep

# ─── Benchmark outputs (regenerated by the harness) ────────────────────────────
benchmark/report/

# ─── Suricata rules downloaded by suricata-update (not source) ─────────────────
ids/rules/suricata.rules

# ─── Secrets / env ─────────────────────────────────────────────────────────────
.env
*.pem

# ─── OS cruft ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Working notes / local tooling (kept on disk, not published) ───────────────
notes/
ROADMAP.md
CLAUDE.md
.claude/
.codegraph/
*.bundle
